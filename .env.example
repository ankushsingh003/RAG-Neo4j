# ==============================================================================
# Advanced RAG System Configuration
# ==============================================================================

# Embedding & Reranking Models
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Chunking Parameters
CHUNK_SIZE=400
CHUNK_OVERLAP=80

# Retrieval Defaults
DEFAULT_TOP_K=5
HYBRID_ALPHA=0.5
RRF_K=60
RERANK_TOP_N=3

# Neo4j Graph Database Credentials (Live or Fallback)
# If left default or unreachable, system automatically runs with zero-error In-Memory Fallback
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j
USE_IN_MEMORY_GRAPH_FALLBACK=true

# Optional LLM API Keys (High-fidelity local synthesizer active if empty)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEFAULT_LLM_PROVIDER=auto
